# ─────────────────────────────────────────────────────────────────
#  .env.example  —  Environment variable template
#
#  Copy this file to .env and fill in your values.
#  The .env file is listed in .gitignore and will NEVER be committed.
#  Do NOT put real secrets in this file.
# ─────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────
# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames
# Development:   ALLOWED_HOSTS=localhost,127.0.0.1,*
# Production:    ALLOWED_HOSTS=yourdomain.com,yourapp.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ── Database ──────────────────────────────────────────────────────
# Leave EMPTY to use SQLite (local development default).
# Set to a PostgreSQL URL for staging/production.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Examples:
#   Render:   DATABASE_URL=postgresql://user:pass@oregon-postgres.render.com/mydb
#   Railway:  DATABASE_URL=postgresql://postgres:pass@containers-us-west-12.railway.app:5432/railway
#   Local PG: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mortgage_db
DATABASE_URL=

# ── CSRF ──────────────────────────────────────────────────────────
# Required for Django 4.x on HTTPS (e.g. Render, Railway, fly.io).
# Full origins, comma-separated: scheme + host, NO trailing slash.
# Example: CSRF_TRUSTED_ORIGINS=https://yourapp.onrender.com
CSRF_TRUSTED_ORIGINS=

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated origins allowed to make cross-origin requests.
# Development: leave blank (CORS_ALLOW_ALL_ORIGINS=True is used as fallback).
# Production:  restrict to your app's actual domain.
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Media files ───────────────────────────────────────────────────
# For cloud hosting, consider S3/Cloudinary.
# Local development uses MEDIA_ROOT (./media/).
# No change needed for basic deployment.
